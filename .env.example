# App
APP_NAME=KnoweTrade
APP_ENV=development
APP_MODE=paper
# Alpaca paper accounts default to $100k; used for all-time gain/loss on the dashboard.
PAPER_ACCOUNT_STARTING_EQUITY=100000
LOG_LEVEL=INFO

# API
API_PORT=8000
ADMIN_API_KEY=change-me

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Database (Supabase Postgres recommended)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/knowetrade

# Trading assumptions (v1 long-only ETFs loaded from DB symbols table)
STRATEGY_BUCKET=etf_trend
# momentum_rotation (default) | trend_following
PORTFOLIO_STRATEGY=momentum_rotation
MOMENTUM_LOOKBACK_DAYS=20
# conservative | moderate | aggressive | ultra_aggressive
RISK_APPETITE=ultra_aggressive
MAX_POSITION_NOTIONAL_USD=50000
DAILY_LOSS_THRESHOLD_PCT=-5.0
DAILY_PNL_PCT=0
RECONCILE_FORCE_MISMATCH=false
DRY_RUN=true
TRADING_ENABLED=false
ENABLE_ORDER_SUBMISSION=false
WORKER_JOB_NAME=etf_data_ingestion
WORKER_POLL_SECONDS=60
TARGET_POSITION_QTY_PER_SYMBOL=1
MAX_PORTFOLIO_POSITIONS=20
MAX_OPEN_POSITIONS=20
MAX_POSITION_PCT=0.30
# equity_weighted (default) sizes each buy toward proposal target_weight; fixed_qty uses PAPER_ORDER_QTY
ORDER_SIZING_MODE=equity_weighted
ORDER_SUBMISSION_ENABLED=false
PAPER_ORDER_QTY=5
AUTO_EXIT_ORPHAN_POSITIONS=true
SUMMARY_INTERVAL_MINUTES=1440

# Alpaca
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_SECRET_KEY=

# Alerts (trades_only = Slack only when an order hits the broker; all = legacy verbose mode)
SLACK_ALERTS_ENABLED=true
SLACK_NOTIFY_MODE=trades_only
SLACK_WEBHOOK_URL=
